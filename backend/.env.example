# ─────────────────────────────────────────────────────────────
#  RestaurantOS — Backend Environment
#  Copy to `.env` and fill in. Only DATABASE_URL and the two JWT
#  secrets are required; every integration below degrades safely.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# ── Database (required) ──────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
# Use the "Session pooler" (port 5432) or "Transaction pooler" (6543).
# Remember to URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ── JWT (required) ───────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Client URL (used in password-reset emails) ───────────────
CLIENT_URL=http://localhost:5173

# ── File storage (optional) ──────────────────────────────────
# Provider is chosen at boot: Supabase → Cloudinary → local disk.
# Leave all blank to write uploads to ./uploads and serve them
# from /uploads — fine for local development.

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=restaurant-os

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (optional) ─────────────────────────────────────────
# Leave blank to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=RestaurantOS
MAIL_FROM_ADDRESS=no-reply@restaurantos.app

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=30
